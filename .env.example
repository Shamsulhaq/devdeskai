# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Ollama configuration
OLLAMA_HOST=http://localhost:11434
MODEL=gemma4:e4b

# Bot personality
SYSTEM_PROMPT=You are DevDeskAI, an AI assistant. Respond conversationally and concisely.

# Max conversation history per user (pairs of messages)
MAX_HISTORY=20

# Admin user IDs (comma-separated, for /announce command)
ADMIN_IDS=123456789,987654321

# Workspace directory for coding agent tasks
WORKSPACE_DIR=./workspace

# Bot username (required for group chat mention support)
# BOT_USERNAME=my_devdeskai_bot

# Webhook mode (uncomment to switch from polling to webhook)
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PORT=8443
# WEBHOOK_SECRET=your_secret

# Custom commands: /<name> runs the prompt
# CUSTOM_CMD_REVIEW=Review the following code for bugs and improvements
# CUSTOM_CMD_TRANSLATE=Translate the following text to Spanish
# CUSTOM_CMD_EXPLAIN=Explain this concept simply

# Brain agent manager — fallback Ollama models (comma-separated).
# Used by try_with_model_swap() when the current model is producing
# low-quality output. Order matters; brain cycles through them.
# FALLBACK_MODELS=llama3.2:3b,gemma3:4b,mistral:7b

# Brain agent manager — confidence threshold (0.0-1.0) above which
# the brain runs tests itself rather than delegating to a test agent.
# Default 0.7. Lower = brain tries more things itself.
# TEST_CONFIDENCE_THRESHOLD=0.7
